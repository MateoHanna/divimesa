# Supabase (Settings > API Keys en el dashboard del proyecto)
NEXT_PUBLIC_SUPABASE_URL=https://xauhctelzpymsafxlgtj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# PIN del panel de la DEMO (código de restaurante vacío o "demo"). No abre ningún restaurante real:
# cada restaurante real tiene su propio PIN, que genera scripts/crear-restaurante.mjs y se guarda solo con hash.
PANEL_PIN=

# Pagos
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=

# Dominio estable de producción (sin ruta). Los QR y los webhooks usan SOLO esto, nunca VERCEL_URL.
# En Vercel: https://demo-qr-steel.vercel.app   En local: http://localhost:3000
APP_URL=http://localhost:3000

# Opcional: video de la portada. Vacío = la sección no se muestra.
# Subir el archivo a public/brand/ y poner su ruta (o una dirección completa), luego redesplegar.
NEXT_PUBLIC_DEMO_VIDEO_URL=
